// Control flow: nested loops with break/continue, for loops with missing
// parts, dangling else, short-circuit side effects, increments.

int calls = 0;

bool touch(bool v) {
    calls++;
    return v;
}

void main() {
    // dangling else binds to the nearest if
    int x = 5;
    if (x > 0) if (x > 10) Print("big\n"); else Print("small\n");

    // short-circuit: touch(false) must not be evaluated twice
    if (touch(false) && touch(true)) Print("no\n");
    if (touch(true) || touch(true)) Print("yes\n");
    Print("calls=", calls, "\n");

    // nested loops, continue and break target the innermost loop
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            if (j == i) continue;
            if (j > 2) break;
            Print(i, j, " ");
        }
    }
    Print("\n");

    // for without init / step, while with complex condition
    int k = 10;
    for (; k > 0;) k -= 3;
    Print("k=", k, "\n");
    int n = 0;
    while (n < 100 && !(n % 17 == 0 && n > 0)) n++;
    Print("n=", n, "\n");

    // pre/post increment as values
    int a = 1;
    int b = a++ + ++a;      // 1 + 3
    Print(a, " ", b, "\n");
    int[] arr = NewArray(3, int);
    int idx = 0;
    arr[idx++] = 7;
    arr[idx++] = 8;
    arr[idx] = 9;
    Print(arr[0], arr[1], arr[2], " idx=", idx, "\n");

    // unary minus, modulo of negatives, double formatting
    Print(-x, " ", -7 % 3, " ", 7 % -3, " ", -2.5 * 2, " ", 1.0 / 3.0, "\n");
    Print(3 > 2.5, " ", 2 == 2.0, " ", 10 / 4, " ", 10 / 4.0, "\n");
}
