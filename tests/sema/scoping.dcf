// Valid program: no diagnostics expected. Exercises scoping rules and
// implicit conversions that the checker must accept.

int shared = 1;

class Counter {
    int count;
    int step;

    void init(int s) {
        step = s;              // field via implicit this
        count = 0;
    }

    int tick() {
        int count = 100;       // local shadows the field
        this.count += step;    // explicit this reaches the field
        return count + this.count;
    }

    int twice() { return tick() + tick(); }   // implicit this method call
}

interface Shape { double area(); }

class Sq implements Shape {
    int side;
    double area() { return side * side; }     // int -> double promotion on return
}

double half(double v) { return v / 2; }

int main() {
    int shared = 5;            // local shadows the global
    double d = shared;         // promotion in initializer
    d = d + shared * 2;        // promotion inside arithmetic
    d += 1;                    // promotion in compound assignment
    Print(half(shared), " ", d > 3, " ", shared < 2.5, "\n");
    for (int i = 0; i < 2; i++) {
        int shared = i;        // loop scope
        Print(shared);
    }
    Counter c = New(Counter);
    c.init(2);
    Print(c.twice(), "\n");
    Shape s = New(Sq);
    Print(s.area(), "\n");
    Sq q = null;
    if (s != q) Print("ok\n");
    return 0;
}
